{
  "name": "traverse",
  "version": "0.2.0",
  "private": true,
  "description": "Traverse — bikepacking and hiking trip companion",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "seed": "node --enable-source-maps dist/seed.js",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsc -p tsconfig.json --watch & nodemon --watch dist dist/index.js",
    "postinstall": "prisma generate",
    "release": "prisma migrate deploy && (node dist/seed.js || true)"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.6.3"
  }
}
